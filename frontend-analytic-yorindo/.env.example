# Public origin used for registration links and QR codes.
# For ngrok, set this to your dev domain, e.g. https://abcxyz.ngrok-free.dev
# Leave empty to fall back to window.location.origin (localhost in local dev).
VITE_PUBLIC_SITE_URL=

# Leave empty to use relative /api/... paths through the Vite proxy.
# This is required when the app is accessed via ngrok.
VITE_API_BASE_URL=

# Leave empty to use the relative /api/v1/form-builder/slug path.
VITE_API_URL=

# Email tujuan tautan "Contact admin" di halaman login.
# Jika gmail.com/googlemail.com, tautan membuka Gmail compose dengan pesan siap ketik.
# Selain itu, tautan memakai mailto:. Kosongkan untuk menyembunyikan tautan.
VITE_ADMIN_EMAIL=

# Visual scale of the whole app (0.9 = 90%). Browser zoom stays 100%.
# Range 0 < value <= 1. Leave empty to use the default 0.9.
VITE_UI_SCALE=
