PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5174

MONGODB_URI=mongodb://127.0.0.1:27017/yorindo-ems

JWT_SECRET=change-me
JWT_EXPIRES_IN_HOURS=8

OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SKIP_SMTP_VERIFY=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

SMTP_FROM_NAME=Yorindo EMS
SMTP_FROM=no-reply@example.com
# Alias yang juga didukung:
# MAIL_FROM_NAME=Yorindo EMS
# MAIL_FROM_EMAIL=no-reply@example.com

# Dibutuhkan oleh fitur AI sentiment analysis (feedback.service.ts)
OPENAI_API_KEY=your-openai-api-key

# LLM untuk generate insight (opsional).
# Jika dikosongkan, insight tetap dibuat dengan ringkasan otomatis berbasis data.
# Contoh OpenAI-compatible: https://api.openai.com/v1 + gpt-4o-mini
# Contoh Groq: https://api.groq.com/openai/v1 + llama-3.3-70b-versatile
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=20000
LLM_RETRY_ATTEMPTS=1
